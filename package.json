{
  "name": "kit-app",
  "version": "0.1.0",
  "private": true,
  "description": "An app made from isleofdan/starting-kit. Its name and title live in app.json, nowhere else.",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prestart": "node scripts/build-scene.mjs",
    "start": "node server.js",
    "dev": "node scripts/build-scene.mjs && COOKIE_INSECURE=1 node server.js",
    "pretest": "node scripts/build-scene.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "prescreenshots": "node scripts/build-scene.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "check": "node scripts/check.mjs",
    "build": "node scripts/build-sentry.mjs",
    "build:scene": "node scripts/build-scene.mjs",
    "gun-records": "node scripts/gun-records.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "1.56.1",
    "three": "^0.187.0"
  },
  "dependencies": {
    "@sentry/browser": "^11.9.0",
    "@sentry/node": "^11.9.0"
  }
}
