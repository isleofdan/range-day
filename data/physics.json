 "transonicSpread": {
  "sigmaFactorBelowMach1_2": {
   "value": 1.5,
   "estimate": "A bullet between Mach 1.2 and Mach 1 is losing its steadiness; the extra scatter is not published for these loads. Half again the per-axis spread is the order long-range shooters report for match bullets going transonic; it is an estimate until measured."
  },
  "sigmaFactorBelowMach1": {
   "value": 2.5,
   "estimate": "Once subsonic a bullet that went through the barrier may yaw or tumble; two and a half times the per-axis spread is an estimate with the same basis as the transonic factor."
  },
  "fiveShotExtremeSpreadOverSigma": {
   "value": 3.06,
   "estimate": "The expected extreme spread of five shots from a round normal scatter is about 3.06 standard deviations (Taylor and Grubbs, 'Approximate probability distributions for the extreme spread', 1975); groups are quoted as five-shot extreme spread, so sigma = spread / 3.06."
  },
  "appliesOnlyAboveMuzzleMach": {
   "value": 1.2,
   "estimate": "It is the passage through the sound barrier that unsettles a bullet, so the two factors above apply only to a bullet that left the barrel above Mach 1.2; a load that starts below that (the .22 at 1,070 fps, Mach 0.96) never crosses anything and keeps its own spread at every distance. The threshold is the top of the transonic band, the same figure the first factor uses."
  }
 },
 "dust": {
  "startFt": {
   "value": 2,
   "estimate": "a rifle bullet into dry dirt throws a puff about 2 ft across at the first instant (a plume twice the height of a boot, as range videos show); not measured"
